  id: story_stage1
  lines:
  - speakerName: "\uC2A4\uD1A0\uB9AC \uC694\uC6D0"
    portrait: {fileID: 0}
    expression: Joy
    text: "\uC694\uC998 \uBD88\uD3B8\uB9E8\uB2D8 \uC5BC\uAD74\uC744 \uC790\uC8FC
      \uBD59\uB124\uC694."
  - speakerName: "\uC2A4\uD1A0\uB9AC \uC694\uC6D0"
    portrait: {fileID: 0}
    expression: Embarrassed
    text: "\uC194\uC9C1\uD788 \uCC98\uC74C\uC5D4, \uC0AC\uB839\uAD00\uB2D8\uC774
      \uB370\uB824\uC628 \uB9E8\uC8FC\uBA39 \uC2E0\uC785\uC774\uB77C \uC870\uAE08
      \uC5B4\uB824\uC6E0\uC5B4\uC694."
  - speakerName: "\uC2A4\uD1A0\uB9AC \uC694\uC6D0"
    portrait: {fileID: 0}
    expression: Cheer
    text: "\uC774\uC81C\uB294 \uD3B8\uD558\uAC8C \uB9D0 \uAC78\uC5B4\uB3C4 \uB418\uACA0\uC8E0?"
