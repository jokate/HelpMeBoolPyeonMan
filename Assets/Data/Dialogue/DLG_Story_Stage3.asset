  lines:
  - speakerName: "\uC2A4\uD1A0\uB9AC \uC694\uC6D0"
    portrait: {fileID: 0}
    expression: Embarrassed
    text: "\uBD88\uD3B8\uB9E8\uB2D8\uAED8 \uB4DC\uB9AC\uACE0 \uC2F6\uC740 \uAC8C
