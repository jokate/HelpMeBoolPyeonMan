  - speakerName: "\uC2A4\uD1A0\uB9AC \uC694\uC6D0"
    portrait: {fileID: 0}
    expression: Cheer
    text: "\uC81C\uAC00 \uC190\uBD24\uC5B4\uC694, '\uC5F0\uC18D \uC9C0\uC6D0 Mk.II'\uC608\uC694."
  - speakerName: "\uC2A4\uD1A0\uB9AC \uC694\uC6D0"
