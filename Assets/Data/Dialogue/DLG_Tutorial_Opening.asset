  m_Script: {fileID: 11500000, guid: d875b3d6d4592124cb6520c8fecf3d57, type: 3}
  m_Name: DLG_Tutorial_Opening
  m_EditorClassIdentifier: BoolPyeon.Dialogue::BoolPyeon.Dialogue.DialogueDefinition
  id: Tutorial_Opening
  lines:
  - speakerName: "\uD68C\uC0AC\uC6D0"
    portrait: {fileID: 0}
    expression: Tired
    text: "\uD558\uC544\u2026 \uB4DC\uB514\uC5B4 \uD1F4\uADFC. \uC624\uB298\uB3C4
      \uCE58\uD0A8\uC5D0 \uB9E5\uC8FC, \uAC8C\uC784 \uD55C \uD310\uC774\uBA74 \uC644\uBCBD\uD558\uC9C0."
  - speakerName: "\uD68C\uC0AC\uC6D0"
    portrait: {fileID: 0}
    expression: Panic
    text: "\u2026\uC5B4? \uAC00\uAC8C\uAC00 \uBB38\uC744 \uB2EB\uC558\uC796\uC544.
      \uC640\uC774\uD30C\uC774\uB3C4 \uC548 \uB418\uACE0\u2026 \uC65C \uC804\uBD80
      \uC774 \uBAA8\uC591\uC774\uC57C?"
  - speakerName: "\uBD88\uD3B8\uC758 \uC545\uB9C8"
    portrait: {fileID: 0}
    expression: Laugh
    text: "\uD06C\uD06C\uD06C, \uB124 \uD558\uB8E8\uB97C \uBD88\uD3B8\uD558\uAC8C
      \uB9CC\uB4DC\uB294 \uAC8C \uB0B4 \uC77C\uC774\uC9C0."
  - speakerName: "\uD68C\uC0AC\uC6D0"
    portrait: {fileID: 0}
    expression: Panic
    text: "\uC18C\uBB38\uC73C\uB85C\uB9CC \uB4E3\uB358 \uBD88\uD3B8\uC758 \uC545\uB9C8\u2026?
      \uB0B4 \uD3C9\uC628\uD55C \uC800\uB141\uC744 \uB9DD\uCE5C \uAC8C \uB108\uC600\uC5B4?!
      \uAC00\uB9CC\uB450\uC9C0 \uC54A\uACA0\uB2E4!"
  - speakerName: "\uD68C\uC0AC\uC6D0"
    portrait: {fileID: 0}
    expression: Determined
    text: "\uB3C4\uC640\uC904 \uC0AC\uB78C\uB3C4 \uC5C6\uACE0\u2026 \uC88B\uC544,
      \uC774 \uBD88\uD3B8\uD568\uC744 \uC804\uBD80 \uD798\uC73C\uB85C \uBC14\uAFD4\uC11C
      \uB450\uB4E4\uACA8 \uC8FC\uB9C8!"
