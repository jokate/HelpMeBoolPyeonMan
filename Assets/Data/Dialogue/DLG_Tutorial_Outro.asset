  m_Script: {fileID: 11500000, guid: d875b3d6d4592124cb6520c8fecf3d57, type: 3}
  m_Name: DLG_Tutorial_Outro
  m_EditorClassIdentifier: BoolPyeon.Dialogue::BoolPyeon.Dialogue.DialogueDefinition
  id: Tutorial_Outro
  lines:
  - speakerName: "\uBD88\uD3B8\uC758 \uC545\uB9C8"
    portrait: {fileID: 0}
    expression: Angry
    text: "\uD06C\uC73D\u2026 \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uB2E4.
      \uD558\uC9C0\uB9CC \uC5B8\uC820\uAC00 \uB2E4\uC2DC \uB108\uB97C \uBD88\uD3B8\uD558\uAC8C
      \uB9CC\uB4E4\uACA0\uB2E4!"
  - speakerName: "COMFORT \uC0AC\uB839\uAD00"
    portrait: {fileID: 0}
    expression: Default
    text: "\uC9C0\uCF1C\uBD24\uB124. \uC7A5\uBE44\uB3C4 \uC9C0\uC6D0\uB3C4 \uC5C6\uC774
      \uBD88\uD3B8\uC758 \uC545\uB9C8\uB97C \uBAB0\uC544\uB0B4\uB2E4\uB2C8."
  - speakerName: "COMFORT \uC0AC\uB839\uAD00"
    portrait: {fileID: 0}
    expression: Default
    text: "\uC6B0\uB9AC\uB294 \uBD88\uD3B8\uACFC \uC2F8\uC6B0\uB294 \uC870\uC9C1
      COMFORT\uC77C\uC138. \uC790\uB124 \uAC19\uC740 \uC0AC\uB78C\uC774 \uD544\uC694\uD574.
      \uD569\uB958\uD574 \uC8FC\uACA0\uB098?"
  - speakerName: "\uD68C\uC0AC\uC6D0"
    portrait: {fileID: 0}
    expression: Relieved
    text: "\uB0B4 \uC77C\uC0C1\uC744 \uB418\uCC3E\uC744 \uC218 \uC788\uB2E4\uBA74\uC57C\u2026
      \uC88B\uC544\uC694, \uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerName: "COMFORT \uC0AC\uB839\uAD00"
    portrait: {fileID: 0}
    expression: Default
    text: "\uD658\uC601\uD558\uB124. \uC624\uB298\uBD80\uD130 \uC790\uB124 \uC774\uB984\uC740
      '\uBD88\uD3B8\uB9E8'\uC774\uB2E4. \uBCF8\uBD80\uB85C \uC548\uB0B4\uD558\uC9C0."
